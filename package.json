{
  "name": "veilborn-final-browser-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/scan-art.mjs && node scripts/build-art-kit.mjs && vite",
    "build": "node scripts/scan-art.mjs && node scripts/build-art-kit.mjs && vite build",
    "preview": "vite preview",
    "art": "node scripts/scan-art.mjs",
    "art-kit": "node scripts/build-art-kit.mjs",
    "test": "node scripts/scan-art.mjs && node tests/e2e.mjs",
    "test:build": "npm run build && node tests/e2e.mjs",
    "build:pages": "node scripts/scan-art.mjs && node scripts/build-art-kit.mjs && VITE_BASE=/veilborn/ vite build"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^7.0.0"
  }
